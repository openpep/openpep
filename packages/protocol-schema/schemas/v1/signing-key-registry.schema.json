{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpep.org/schemas/v1/signing-key-registry.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "OpenPEP signing key registry",
  "description": "Trusted public keys and authorization windows used to verify a clinical ledger.",
  "type": "object",
  "required": ["schema", "keys"],
  "properties": {
    "schema": {
      "const": "openpep/signing-key-registry@1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/signing_key"
      }
    }
  },
  "patternProperties": {
    "^x_[a-z0-9]+(?:_[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "signing_key": {
      "type": "object",
      "required": [
        "key_id",
        "device_id",
        "algorithm",
        "public_key_x963",
        "authorized_from"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^key_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "algorithm": {
          "const": "ES256"
        },
        "public_key_x963": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{87}$"
        },
        "authorized_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "authorized_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "patternProperties": {
        "^x_[a-z0-9]+(?:_[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
