# Configuração opcional para uma implantação institucional. O editor local dispensa estas variáveis.
CRX_ORIGIN=https://rx.sua-instituicao.br
SSO_ISSUER=https://sso.example.org/realms/openpep
SSO_URL_TOKEN=https://sso.example.org/realms/openpep/protocol/openid-connect/token
SSO_URL_INFO=https://sso.example.org/realms/openpep/protocol/openid-connect/userinfo
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CPF_CLAIM=
KV_REST_API_URL=
KV_REST_API_TOKEN=
DATABASE_URL=
DATABASE_CA=
SNCR_PLATFORM_CNPJ=

# Pasta compartilhável com o OpenPEP; o Rx usa a subpasta prescricao/.
# OPENPEP_DATA_DIR=/caminho/para/dados-openpep
# Alternativa: pasta específica do módulo.
# OPENPEP_RX_DATA_DIR=/caminho/para/prescricao
# Opcional: a interface Dados locais também permite configurar estes valores.
# OPENPEP_RX_SNCR_ENV=prd
# OPENPEP_RX_SNCR_ENABLED=true

# Ambiente web autorizado a solicitar conexão ao auxiliar (confirmação local obrigatória).
# OPENPEP_RX_WEB_ORIGINS=https://rx.seu-provedor.com.br

# Portal privado que fornece os lotes. Não exige pareamento web com o auxiliar.
# A chave pública deve ser fornecida pelo administrador por um canal confiável.
# OPENPEP_RX_SNCR_PORTAL=https://rx.seu-provedor.com.br
# OPENPEP_RX_SNCR_TRUST_FILE=/caminho/confiavel/sncr-public-keys.json
# A chave PRIVADA de exportação fica apenas no servidor do portal, nunca aqui.

# Portal opcional de documentos, separado do portal SNCR privado.
# Gere a credencial com scripts/configurar-documentos.mjs; nunca publique o .env.
# OPENPEP_RX_DOCUMENTS_URL=https://documentos.seu-provedor.com.br
# OPENPEP_RX_DOCUMENTS_TOKEN=

# Apenas aliases comprovados do MESMO portal/armazenamento; preserve os domínios antigos.
# OPENPEP_RX_DOCUMENTS_PREVIOUS_ORIGINS=https://portal-anterior.example.org
